            spagPaths=[];
            for(let m=0;m<20;m++){
                let p=[{x:0,y:h/2}], cy=h/2;
                for(let i=1;i<=100;i++){
                    cy += Math.sin(i*0.1+m)*2 + (Math.random()-0.5)*20*(err/100)*Math.exp((i/100)*3);
                    p.push({x:i*(w/100), y:Math.max(20,Math.min(h-20,cy))});
                }
                spagPaths.push({pts:p, col:`hsla(${Math.random()*360},70%,60%,0.8)`});
            }
            spagStep=0;
