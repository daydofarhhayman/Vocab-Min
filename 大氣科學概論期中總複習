<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>大氣科學概論 | 互動學習與期中考實戰總覽</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            scroll-behavior: smooth;
        }

        /* 共通 Chart Container 樣式 */
        .chart-container {
            position: relative;
            width: 100%;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            height: 350px;
            max-height: 400px;
        }
        @media (max-width: 768px) {
            .chart-container { height: 280px; }
        }

        /* --- CH8 特屬樣式 --- */
        .canvas-simulator-8 {
            width: 100%; max-width: 500px; height: 400px; margin: 0 auto;
            background-color: #f5f5f4; border-radius: 0.5rem;
            box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.05);
        }

        /* --- CH9 & CH14 氣流動畫樣式 --- */
        .wind-arrow { transition: all 0.5s ease-in-out; }
        .animate-flow-right { animation: flowRight 2s infinite linear; }
        .animate-flow-left { animation: flowLeft 2s infinite linear; }
        .animate-flow-up { animation: flowUp 2s infinite linear; }
        .animate-flow-down { animation: flowDown 2s infinite linear; }
        @keyframes flowRight { 0% { transform: translateX(calc(-50% - 30px)); opacity: 0; } 50% { opacity: 1; } 100% { transform: translateX(calc(-50% + 30px)); opacity: 0; } }
        @keyframes flowLeft { 0% { transform: translateX(calc(-50% + 30px)); opacity: 0; } 50% { opacity: 1; } 100% { transform: translateX(calc(-50% - 30px)); opacity: 0; } }
        @keyframes flowUp { 0% { transform: translateY(20px); opacity: 0; } 50% { opacity: 1; } 100% { transform: translateY(-20px); opacity: 0; } }
        @keyframes flowDown { 0% { transform: translateY(-20px); opacity: 0; } 50% { opacity: 1; } 100% { transform: translateY(20px); opacity: 0; } }

        /* --- CH13 特屬樣式 --- */
        .canvas-container-13 {
            position: relative; width: 100%; max-width: 800px; margin: 0 auto; height: 400px;
            background-color: #0f172a; border-radius: 0.75rem; overflow: hidden;
            box-shadow: inset 0 4px 6px -1px rgba(0, 0, 0, 0.5);
        }
        
        /* --- CH14 特屬樣式 --- */
        .updraft { animation: flowUp 1.5s infinite linear; color: #ef4444; }
        .downdraft { animation: flowDown 1.5s infinite linear; color: #3b82f6; }
        #hurricane-canvas, #radar-canvas { width: 100%; height: 100%; }
        #hurricane-canvas { background: linear-gradient(to bottom, #1e293b 0%, #0f172a 100%); }
        #radar-canvas { background: #020617; }
        @keyframes radar-spin { 100% { transform: rotate(360deg); } }

        /* 按鈕 active 狀態 */
        .scale-btn.active, .tab-btn.active, .stage-btn.active {
            background-color: #38bdf8; color: white; border-color: #0284c7;
        }
        .stage-btn.active { background-color: #3b82f6; box-shadow: 0 0 15px rgba(59, 130, 246, 0.5); }

        /* --- 考試系統 Tooltip 與卡片樣式 --- */
        .term-tooltip {
            position: relative; display: inline-block; cursor: help;
            color: #0284c7; font-weight: 700; border-bottom: 2px dashed #38bdf8;
            transition: all 0.2s; margin: 0 2px;
        }
        .term-tooltip:hover {
            color: #0369a1; background-color: rgba(56, 189, 248, 0.1); border-radius: 2px;
        }
        .term-tooltip .tooltip-content {
            visibility: hidden; opacity: 0; width: 280px; background-color: #0f172a; color: #f8fafc;
            text-align: left; border-radius: 0.5rem; padding: 14px; position: absolute;
            z-index: 100; bottom: 130%; left: 50%; transform: translateX(-50%) translateY(10px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
            transition: opacity 0.3s, transform 0.3s; font-size: 0.875rem; font-weight: normal;
            line-height: 1.6; pointer-events: none; border: 1px solid #334155;
        }
        .term-tooltip .tooltip-content::after {
            content: ""; position: absolute; top: 100%; left: 50%; margin-left: -8px;
            border-width: 8px; border-style: solid; border-color: #0f172a transparent transparent transparent;
        }
        .term-tooltip:hover .tooltip-content {
            visibility: visible; opacity: 1; transform: translateX(-50%) translateY(0);
        }
        .tooltip-title {
            display: block; color: #38bdf8; font-weight: bold; margin-bottom: 6px;
            border-bottom: 1px solid #334155; padding-bottom: 6px; font-size: 0.95rem;
        }
        .q-card { transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
        .q-card:hover { transform: translateY(-3px); box-shadow: 0 12px 20px -3px rgba(0, 0, 0, 0.1); border-color: #94a3b8; }
        .correct-active { background-color: #ecfdf5 !important; border-left: 4px solid #10b981 !important; font-weight: 600; color: #065f46; }
        
        /* Navbar 隱藏滾動條 */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="antialiased">

    <!-- 頂部全局導覽列 -->
    <nav class="bg-slate-900 text-white sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-3">
                    <span class="text-2xl">🌍</span>
                    <span class="font-bold text-lg tracking-widest hidden md:block">大氣科學概論總覽</span>
                    <span class="font-bold text-lg tracking-widest md:hidden">AP1001</span>
                </div>
                <div class="flex space-x-1 md:space-x-4 overflow-x-auto no-scrollbar items-center">
                    <button onclick="scrollToSection('ch8')" class="text-slate-300 hover:text-sky-400 px-2 py-2 text-sm font-medium transition whitespace-nowrap">Ch8. 氣壓與風</button>
                    <button onclick="scrollToSection('ch9')" class="text-slate-300 hover:text-sky-400 px-2 py-2 text-sm font-medium transition whitespace-nowrap">Ch9. 局地風</button>
                    <button onclick="scrollToSection('ch13')" class="text-slate-300 hover:text-sky-400 px-2 py-2 text-sm font-medium transition whitespace-nowrap">Ch13. 預報</button>
                    <button onclick="scrollToSection('ch14')" class="text-slate-300 hover:text-sky-400 px-2 py-2 text-sm font-medium transition whitespace-nowrap">Ch14-16. 劇烈天氣</button>
                    <button onclick="scrollToSection('exam')" class="bg-sky-700 hover:bg-sky-600 text-white px-3 py-1.5 rounded text-sm font-bold transition whitespace-nowrap ml-2">期中考題庫</button>
                </div>
            </div>
        </div>
    </nav>

    <!-- 總標頭 -->
    <header class="bg-gradient-to-br from-slate-800 to-slate-900 py-20 px-4 text-white border-b-4 border-sky-500 relative overflow-hidden">
        <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#38bdf8 1px, transparent 1px); background-size: 30px 30px;"></div>
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <span class="bg-sky-500/20 text-sky-400 border border-sky-500/30 px-4 py-1 rounded-full text-sm font-bold tracking-wider mb-6 inline-block">AP1001 INTERACTIVE MASTERCLASS</span>
            <h1 class="text-4xl md:text-6xl font-extrabold mb-6 tracking-tight">大氣科學概論 互動學習總覽</h1>
            <p class="text-lg md:text-xl text-slate-300 leading-relaxed font-light">
                整合第 8 章至第 16 章核心氣象概念，涵蓋大氣動力學、局地熱力環流、數值天氣預報與劇烈風暴，並附帶完整期中考實戰演練與動態名詞解析。
            </p>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-32">

        <!-- ==========================================
             CHAPTER 8: 氣壓與風
             ========================================== -->
        <section id="ch8" class="scroll-mt-24 pt-8">
            <div class="mb-12 text-center">
                <span class="text-sky-500 font-bold tracking-widest text-sm">CHAPTER 8</span>
                <h2 class="text-4xl font-extrabold text-slate-800 mt-2">大氣壓力與風的奧秘</h2>
                <div class="w-24 h-1 bg-sky-500 mx-auto mt-4 rounded-full"></div>
            </div>

            <!-- CH8 Content -->
            <div class="space-y-16">
                <!-- Diurnal Pressure -->
                <div>
                    <h3 class="text-2xl font-bold text-slate-800 mb-4 border-l-4 border-sky-600 pl-4">1. 氣壓的半日波變化</h3>
                    <p class="text-slate-600 mb-6 text-lg">地表氣壓在一天之中會有規律的半日波變化（特別在熱帶地區），這與太陽輻射加熱密切相關。</p>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                        <div class="chart-container"><canvas id="ch8-diurnalChart"></canvas></div>
                    </div>
                </div>

                <!-- Coriolis -->
                <div>
                    <h3 class="text-2xl font-bold text-slate-800 mb-4 border-l-4 border-rose-600 pl-4">2. 旋轉地球的魔法：科氏力</h3>
                    <p class="text-slate-600 mb-6 text-lg">科氏力的大小取決於風速與緯度。風速越快、緯度越高，偏轉的力量就越大；赤道上科氏力為零。</p>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                        <div class="chart-container"><canvas id="ch8-coriolisChart"></canvas></div>
                    </div>
                </div>

                <!-- Wind Vector Simulator -->
                <div>
                    <h3 class="text-2xl font-bold text-slate-800 mb-4 border-l-4 border-emerald-600 pl-4">3. 地面風與高空風受力模擬</h3>
                    <p class="text-slate-600 mb-6 text-lg">操作下方滑桿，即時觀察氣壓梯度力(PGF)、科氏力(CF)與摩擦力如何共同決定風的最終流向與速度。</p>
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                        <div class="lg:col-span-4 flex flex-col justify-center space-y-8 bg-slate-50 p-6 rounded-xl border border-slate-100">
                            <h4 class="text-lg font-bold text-slate-800 border-b border-slate-200 pb-2">控制面板 ⚙️</h4>
                            <div>
                                <label class="flex justify-between text-sm font-semibold text-slate-700 mb-2">
                                    <span>氣壓梯度力 (PGF)</span><span id="ch8-pgfValue" class="text-sky-600 font-bold">強</span>
                                </label>
                                <input type="range" id="ch8-pgfSlider" min="1" max="10" value="8" class="w-full accent-sky-500">
                            </div>
                            <div>
                                <label class="flex justify-between text-sm font-semibold text-slate-700 mb-2">
                                    <span>緯度 (影響科氏力)</span><span id="ch8-latValue" class="text-rose-600 font-bold">45°N</span>
                                </label>
                                <input type="range" id="ch8-latSlider" min="0" max="90" value="45" class="w-full accent-rose-500">
                            </div>
                            <div>
                                <label class="flex justify-between text-sm font-semibold text-slate-700 mb-2">
                                    <span>地面摩擦力</span><span id="ch8-fricValue" class="text-emerald-600 font-bold">高空 (無摩擦)</span>
                                </label>
                                <input type="range" id="ch8-fricSlider" min="0" max="10" value="0" class="w-full accent-emerald-500">
                            </div>
                        </div>
                        <div class="lg:col-span-8 flex flex-col items-center">
                            <div class="w-full flex justify-between text-sm font-bold text-rose-600 mb-2 px-4"><span>↑ 低壓區 (L)</span></div>
                            <canvas id="ch8-vectorCanvas" class="canvas-simulator-8 border border-slate-300"></canvas>
                            <div class="w-full flex justify-between text-sm font-bold text-sky-600 mt-2 px-4"><span>↓ 高壓區 (H)</span></div>
                            <div class="mt-6 flex flex-wrap justify-center gap-4 text-sm font-bold">
                                <div class="flex items-center gap-1"><span class="inline-block w-4 h-1 bg-red-500"></span>PGF</div>
                                <div class="flex items-center gap-1"><span class="inline-block w-4 h-1 bg-blue-500"></span>科氏力</div>
                                <div class="flex items-center gap-1"><span class="inline-block w-4 h-1 bg-emerald-500"></span>摩擦力</div>
                                <div class="flex items-center gap-1"><span class="inline-block w-6 h-2 bg-slate-800 rounded-full"></span>最終風向</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <hr class="border-slate-200 border-2 rounded">

        <!-- ==========================================
             CHAPTER 9: 局地風
             ========================================== -->
        <section id="ch9" class="scroll-mt-24 pt-8">
            <div class="mb-12 text-center">
                <span class="text-amber-500 font-bold tracking-widest text-sm">CHAPTER 9</span>
                <h2 class="text-4xl font-extrabold text-slate-800 mt-2">小尺度風與局地系統</h2>
                <div class="w-24 h-1 bg-amber-500 mx-auto mt-4 rounded-full"></div>
            </div>

            <div class="space-y-16">
                <!-- Scales of Motion -->
                <div>
                    <h3 class="text-2xl font-bold text-slate-800 mb-4 border-l-4 border-sky-500 pl-4">1. 大氣運動的尺度</h3>
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                        <div class="flex flex-wrap gap-2 mb-6 border-b border-slate-100 pb-4">
                            <button class="scale-btn active px-4 py-2 rounded-lg font-semibold border hover:bg-sky-50 transition" onclick="updateScale9('micro', this)">微尺度</button>
                            <button class="scale-btn px-4 py-2 rounded-lg font-semibold border hover:bg-sky-50 transition" onclick="updateScale9('meso', this)">中尺度</button>
                            <button class="scale-btn px-4 py-2 rounded-lg font-semibold border hover:bg-sky-50 transition" onclick="updateScale9('synoptic', this)">天氣尺度</button>
                            <button class="scale-btn px-4 py-2 rounded-lg font-semibold border hover:bg-sky-50 transition" onclick="updateScale9('macro', this)">宏觀尺度</button>
                        </div>
                        <div class="min-h-[150px] flex flex-col justify-center bg-slate-50 rounded-xl p-6 border border-slate-100">
                            <h4 id="ch9-scale-title" class="text-2xl font-bold text-sky-600 mb-2">微尺度 (Microscale)</h4>
                            <p class="text-slate-700 mt-2"><strong class="text-slate-900">📏 範圍與時間：</strong> <span id="ch9-scale-info">直徑約幾公尺（< 2m），數秒到數分鐘</span></p>
                            <p class="text-slate-700 mt-2"><strong class="text-slate-900">💡 典型實例：</strong> <span id="ch9-scale-examples">小陣風 (gusts)、微小亂流、樹葉間的渦流。</span></p>
                        </div>
                    </div>
                </div>

                <!-- Sea/Land Breeze Simulator -->
                <div>
                    <h3 class="text-2xl font-bold text-slate-800 mb-4 border-l-4 border-amber-500 pl-4">2. 海陸風熱力環流模擬</h3>
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                        <div class="bg-slate-100 px-6 py-4 border-b flex justify-between items-center">
                            <h4 class="font-bold text-lg text-slate-800">日夜切換</h4>
                            <div class="flex items-center gap-3">
                                <span class="text-slate-600 font-medium">☀️ 白天</span>
                                <button onclick="toggleDayNight9()" class="w-14 h-7 rounded-full relative transition-colors duration-300 focus:outline-none bg-sky-400" id="ch9-toggleBg">
                                    <div id="ch9-toggleKnob" class="w-5 h-5 bg-white rounded-full absolute top-1 left-1 transition-transform duration-300 transform translateX(0)"></div>
                                </button>
                                <span class="text-slate-600 font-medium">🌙 夜晚</span>
                            </div>
                        </div>
                        <div class="grid md:grid-cols-2 gap-0">
                            <div class="relative h-80 bg-sky-50 flex items-end overflow-hidden" id="ch9-simView">
                                <div id="ch9-sunMoon" class="absolute top-6 left-1/2 transform -translate-x-1/2 text-5xl transition-all duration-500">☀️</div>
                                <div class="absolute inset-0 flex">
                                    <div class="w-1/2 h-full flex flex-col justify-end items-center pb-8 z-10">
                                        <div id="ch9-landP" class="text-red-500 font-bold text-2xl mb-12 bg-white/80 px-3 py-1 rounded">L (低壓)</div>
                                        <div id="ch9-landT" class="text-slate-800 font-bold">陸地 (升溫快)</div>
                                    </div>
                                    <div class="w-1/2 h-full flex flex-col justify-end items-center pb-8 z-10">
                                        <div id="ch9-seaP" class="text-blue-500 font-bold text-2xl mb-12 bg-white/80 px-3 py-1 rounded">H (高壓)</div>
                                        <div id="ch9-seaT" class="text-slate-800 font-bold">海洋 (升溫慢)</div>
                                    </div>
                                </div>
                                <div class="absolute inset-0 z-20 pointer-events-none">
                                    <div id="ch9-upWind" class="absolute top-1/4 left-1/2 transform -translate-x-1/2 flex flex-col items-center animate-flow-right">
                                        <span class="text-xs text-slate-500 font-bold mb-1">高空風</span><span class="text-3xl text-slate-400 leading-none">→</span>
                                    </div>
                                    <div id="ch9-sfcWind" class="absolute bottom-1/3 left-1/2 transform -translate-x-1/2 flex flex-col items-center animate-flow-left">
                                        <span class="text-4xl text-sky-600 font-bold leading-none">←</span><span id="ch9-sfcLabel" class="text-sm text-sky-700 font-bold mt-1">海風 (向陸地)</span>
                                    </div>
                                    <div id="ch9-landV" class="absolute bottom-1/3 left-1/4 text-3xl text-red-400 animate-flow-up flex flex-col items-center">
                                        <span>↑</span><span class="text-xs font-bold mt-1">上升</span>
                                    </div>
                                    <div id="ch9-seaV" class="absolute bottom-1/3 right-1/4 text-3xl text-blue-400 animate-flow-down flex flex-col items-center">
                                        <span>↓</span><span class="text-xs font-bold mt-1">下沉</span>
                                    </div>
                                </div>
                                <div class="w-1/2 h-24 bg-amber-200 border-t-4 border-amber-300" id="ch9-landBlock"></div>
                                <div class="w-1/2 h-24 bg-blue-300 border-t-4 border-blue-400" id="ch9-seaBlock"></div>
                            </div>
                            <div class="p-6 bg-white flex flex-col justify-center border-l">
                                <h4 id="ch9-simTitle" class="text-2xl font-bold text-sky-600 mb-4">海風 (Sea Breeze)</h4>
                                <p id="ch9-simDesc" class="text-slate-600 leading-relaxed">白天陸地升溫快形成熱力低壓；海洋升溫慢形成相對高壓。底層風由海洋吹向陸地。</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Taiwan Wind Energy & Rose -->
                <div class="grid lg:grid-cols-2 gap-8">
                    <div>
                        <h3 class="text-xl font-bold text-slate-800 mb-4 border-l-4 border-emerald-500 pl-4">3. 台灣離岸風電潛力</h3>
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                            <div class="chart-container"><canvas id="ch9-topSitesChart"></canvas></div>
                        </div>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-slate-800 mb-4 border-l-4 border-purple-500 pl-4">4. 風花圖 (Wind Rose)</h3>
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                            <div class="chart-container"><canvas id="ch9-windRoseChart"></canvas></div>
                            <p class="text-center text-sm text-slate-500 mt-2">顯示該地區盛行風向（如東北季風）</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <hr class="border-slate-200 border-2 rounded">

        <!-- ==========================================
             CHAPTER 13: 天氣預報
             ========================================== -->
        <section id="ch13" class="scroll-mt-24 pt-8">
            <div class="mb-12 text-center">
                <span class="text-indigo-500 font-bold tracking-widest text-sm">CHAPTER 13</span>
                <h2 class="text-4xl font-extrabold text-slate-800 mt-2">天氣預報：從觀測到混沌</h2>
                <div class="w-24 h-1 bg-indigo-500 mx-auto mt-4 rounded-full"></div>
            </div>

            <div class="space-y-16">
                <div class="grid lg:grid-cols-2 gap-8">
                    <!-- Obs Chart -->
                    <div>
                        <h3 class="text-xl font-bold text-slate-800 mb-4 border-l-4 border-sky-500 pl-4">1. 觀測網資料不均</h3>
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                            <div class="chart-container"><canvas id="ch13-obsChart"></canvas></div>
                        </div>
                    </div>
                    <!-- Accuracy Chart -->
                    <div>
                        <h3 class="text-xl font-bold text-slate-800 mb-4 border-l-4 border-rose-500 pl-4">2. 預報準確率衰減</h3>
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                            <div class="chart-container"><canvas id="ch13-accChart"></canvas></div>
                        </div>
                    </div>
                </div>

                <!-- Remote Sensing -->
                <div>
                    <h3 class="text-2xl font-bold text-slate-800 mb-4 border-l-4 border-amber-500 pl-4">3. 遙測技術 (Remote Sensing)</h3>
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                        <div class="flex flex-wrap bg-slate-50 border-b" id="ch13-remoteTabs">
