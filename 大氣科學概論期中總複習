                    spagCtx.strokeStyle = idx===0?'#fff':path.col; spagCtx.lineWidth=idx===0?3:1.5; spagCtx.stroke();
                });
                if(spagStep<100) { spagStep+=2; spagAnimId=requestAnimationFrame(drawS); }
            }
