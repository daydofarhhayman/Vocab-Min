    <!-- ==========================================
         JAVASCRIPT LOGIC
         ========================================== -->
    <script>
        // ------------------------------------------------
        // 共通輔助函式
        // ------------------------------------------------
        function scrollToSection(id) {
            document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
        }
        function t(term, title, desc) {
            return `<span class="term-tooltip">${term}<span class="tooltip-content"><span class="tooltip-title">${title}</span>${desc}</span></span>`;
        }

        Chart.defaults.font.family = "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif";
        Chart.defaults.color = '#64748b';

        document.addEventListener('DOMContentLoaded', () => {

            // ------------------------------------------------
            // CH8: 氣壓與風
            // ------------------------------------------------
            const ctxD = document.getElementById('ch8-diurnalChart').getContext('2d');
            new Chart(ctxD, {
                type: 'line',
                data: { labels: ['10AM', '4PM', '10PM', '4AM', '10AM'], datasets: [
                    { label: '中緯度', data: [1009, 1014, 1011, 1008, 1009], borderColor: '#0284c7', backgroundColor: 'rgba(2, 132, 199, 0.1)', borderWidth: 3, fill: true },
                    { label: '熱帶', data: [1010, 1007.5, 1010, 1007.5, 1010], borderColor: '#e11d48', backgroundColor: 'rgba(225, 29, 72, 0.1)', borderWidth: 3, borderDash: [5,5], fill: true }
                ]},
                options: { responsive: true, maintainAspectRatio: false, scales: { y: { min: 1006, max: 1015 } } }
            });

            const ctxC = document.getElementById('ch8-coriolisChart').getContext('2d');
            new Chart(ctxC, {
                type: 'line',
                data: { labels: ['0°', '30°', '60°', '90°'], datasets: [
                    { label: '40 Knots', data: [0, 0.14, 0.25, 0.29], borderColor: '#e11d48', borderWidth: 3 },
                    { label: '20 Knots', data: [0, 0.07, 0.12, 0.14], borderColor: '#4f46e5', borderWidth: 3 }
                ]},
                options: { responsive: true, maintainAspectRatio: false }
            });

            // CH8 Vector Canvas
            const vCan = document.getElementById('ch8-vectorCanvas');
            const vCtx = vCan.getContext('2d');
            const vSliP = document.getElementById('ch8-pgfSlider'), vSliL = document.getElementById('ch8-latSlider'), vSliF = document.getElementById('ch8-fricSlider');
            
            function drawArrow(ctx, x1, y1, x2, y2, color, w=3) {
                const hl=12, a=Math.atan2(y2-y1, x2-x1);
                ctx.beginPath(); ctx.moveTo(x1,y1); ctx.lineTo(x2,y2); ctx.strokeStyle=color; ctx.lineWidth=w; ctx.stroke();
                ctx.beginPath(); ctx.moveTo(x2,y2); ctx.lineTo(x2-hl*Math.cos(a-Math.PI/6), y2-hl*Math.sin(a-Math.PI/6)); ctx.lineTo(x2-hl*Math.cos(a+Math.PI/6), y2-hl*Math.sin(a+Math.PI/6)); ctx.fillStyle=color; ctx.fill();
            }
            function updateV() {
                vCan.width = vCan.clientWidth; vCan.height = vCan.clientHeight;
                const cx=vCan.width/2, cy=vCan.height/2+50, w=vCan.width, h=vCan.height;
                vCtx.clearRect(0,0,w,h);
                
                vCtx.strokeStyle='#d6d3d1'; vCtx.lineWidth=2;
                for(let i=1;i<=3;i++){ vCtx.beginPath(); vCtx.moveTo(0,h*i/4); vCtx.lineTo(w,h*i/4); vCtx.stroke(); }
                vCtx.beginPath(); vCtx.arc(cx,cy,8,0,2*Math.PI); vCtx.fillStyle='#444'; vCtx.fill();

                let p=parseInt(vSliP.value)*15, l=parseInt(vSliL.value), f=parseInt(vSliF.value);
                document.getElementById('ch8-pgfValue').textContent = p>100?'強':'中';
                document.getElementById('ch8-latValue').textContent = l+'°N';
                document.getElementById('ch8-fricValue').textContent = f===0?'高空':(f>7?'粗糙':'平坦');

                drawArrow(vCtx, cx,cy, cx, cy-p, '#ef4444', 4); // PGF
                if(l===0) { drawArrow(vCtx, cx,cy, cx, cy-p, '#1c1917', 6); return; }

                let ang = (-90 + f*4) * Math.PI/180;
                let mag = p * (1-f*0.05);
                drawArrow(vCtx, cx,cy, cx+mag*Math.cos(ang), cy+mag*Math.sin(ang), '#1c1917', 6); // Wind
                drawArrow(vCtx, cx,cy, cx+(mag*Math.sin(l*Math.PI/180))*Math.cos(ang+Math.PI/2), cy+(mag*Math.sin(l*Math.PI/180))*Math.sin(ang+Math.PI/2), '#3b82f6', 4); // Cor
                if(f>0) drawArrow(vCtx, cx,cy, cx+(mag*f*0.08)*Math.cos(ang+Math.PI), cy+(mag*f*0.08)*Math.sin(ang+Math.PI), '#10b981', 4); // Fric
            }
            [vSliP, vSliL, vSliF].forEach(s => s.addEventListener('input', updateV));
            window.addEventListener('resize', updateV);
            updateV();

            // ------------------------------------------------
            // CH9: 局地風
            // ------------------------------------------------
            const ctxTop = document.getElementById('ch9-topSitesChart').getContext('2d');
            new Chart(ctxTop, { type:'doughnut', data:{ labels:['台灣海峽','其他'], datasets:[{data:[16,4], backgroundColor:['#0ea5e9','#cbd5e1']}] }, options:{responsive:true, maintainAspectRatio:false, cutout:'65%'} });
            const ctxRose = document.getElementById('ch9-windRoseChart').getContext('2d');
            new Chart(ctxRose, { type:'polarArea', data:{ labels:['N','NE','E','SE','S','SW','W','NW'], datasets:[{data:[9,18,5,1,3,4,5,8], backgroundColor:'rgba(14,165,233,0.6)'}] }, options:{responsive:true, maintainAspectRatio:false} });

            // ------------------------------------------------
            // CH13: 預報
            // ------------------------------------------------
            new Chart(document.getElementById('ch13-obsChart').getContext('2d'), {
                type:'bar', data:{ labels:['地面','高空','海上'], datasets:[{data:[11000,1000,500], backgroundColor:['#38bdf8','#6366f1','#f59e0b']}] },
                options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}, scales:{y:{type:'logarithmic'}}}
            });
            new Chart(document.getElementById('ch13-accChart').getContext('2d'), {
                type:'line', data:{ labels:['Day 1','Day 3','Day 5','Day 7','Day 10'], datasets:[{data:[95,82,65,40,20], borderColor:'#f43f5e', fill:true, backgroundColor:'rgba(244,63,94,0.1)'}] },
                options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}, scales:{y:{max:100}}}
            });

            // ------------------------------------------------
            // 期中考題庫 Render
            // ------------------------------------------------
            const mcqs = [
                {q:"If two air parcels at sea level have the same size but different temperatures, the colder parcel of air will have", opts:["a. higher pressure, same density", "b. same pressure, lower density", "c. same pressure, higher density", "d. lower pressure, same density"], ans:2, exp:`正解為 <strong>(c)</strong>。<br>在相同氣壓下，溫度越低，空氣分子排列越緊密，${t('密度','密度','D=M/V')}越高。`},
                {q:"Which of the following instruments measures pressure?", opts:["a. barometer", "b. thermometer", "c. radiometer", "d. hygrometer", "e. densitometer"], ans:0, exp:`正解為 <strong>(a)</strong>。<br>${t('氣壓計 (Barometer)','氣壓計','測量大氣壓力的專屬儀器。')}用來測壓。`},
                {q:"On an upper-level chart the wind tends to blow", opts:["a. at right angles to isobars", "b. parallel to isobars", "c. at an angle to contours", "d. at constant speed"], ans:1, exp:`正解為 <strong>(b)</strong>。<br>高空無摩擦力，氣壓梯度力與科氏力平衡形成${t('地轉風','地轉風','平行等壓線吹拂的風')}。`},
                {q:"A ridge on an upper-level isobaric chart indicates", opts:["a. higher-than-average heights", "b. lower-than-average heights", "c. average heights", "d. region with calm winds"], ans:0, exp:`正解為 <strong>(a)</strong>。<br>${t('脊線 (Ridge)','脊線','等高線向極地凸出之處，代表相對高壓。')}高度較高。`},
                {q:"The force that causes stationary air to begin moving is", opts:["a. Coriolis force", "b. pressure gradient force", "c. centripetal force", "d. frictional force"], ans:1, exp:`正解為 <strong>(b)</strong>。<br>${t('氣壓梯度力','PGF','由高壓指向低壓的原始驅動力。')}是唯一能讓靜止空氣移動的力。`},
                {q:"We expect air to be ___ above surface low and ___ above surface high.", opts:["a. rising, rising", "b. rising, sinking", "c. sinking, sinking", "d. sinking, rising"], ans:1, exp:`正解為 <strong>(b)</strong>。<br>低壓中心空氣${t('輻合','輻合','水平匯聚')}並上升；高壓中心空氣輻散並下沉。`},
                {q:"An example of microscale motion is", opts:["a. cyclone", "b. 500 mb winds", "c. city winds", "d. winds blowing past a chimney", "e. global winds"], ans:3, exp:`正解為 <strong>(d)</strong>。<br>煙囪渦流屬於極小的${t('微尺度','微尺度','直徑<2m，維持數秒到數分')}。`},
                {q:"Thermal turbulence is usually most severe", opts:["a. after sunset", "b. at maximum surface heating", "c. around midnight", "d. before sunrise"], ans:1, exp:`正解為 <strong>(b)</strong>。<br>${t('熱力性亂流','熱力性亂流','地表不均勻受熱產生的對流')}在太陽加熱最強時最劇烈。`},
                {q:"The howling of wind on a blustery night is caused by", opts:["a. temp variation", "b. frozen surface", "c. snowflakes", "d. eddies of higher air density", "e. lifting objects"], ans:3, exp:`正解為 <strong>(d)</strong>。<br>風吹過障礙物產生的${t('渦流 (Eddies)','渦流','旋轉的小氣流')}造成壓力變化發出聲波。`},
                {q:"The size and shape of a turbulent eddy depend on", opts:["a. size of obstacle", "b. shape of obstacle", "c. speed of wind", "d. all of the above"], ans:3, exp:`正解為 <strong>(d)</strong>。<br>${t('機械性亂流','機械亂流','受地形地物阻擋產生的擾動')}與障礙物形狀、大小及風速都有關。`},
                {q:"Most practical location for a wind turbine is", opts:["a. strong, gusty winds", "b. downwind side of mountain", "c. narrow valley", "d. moderate, steady winds"], ans:3, exp:`正解為 <strong>(d)</strong>。<br>風機需要${t('穩定風速','穩定風','陣風會損壞葉片')}，避免亂流與強陣風。`},
                {q:"Clouds on downwind side of a lake indicate air is", opts:["a. converging and rising", "b. converging and sinking", "c. diverging and sinking", "d. diverging and rising"], ans:0, exp:`正解為 <strong>(a)</strong>。<br>風吹上陸地因摩擦力變慢，後方空氣追撞造成${t('輻合','輻合抬升','水平氣流擠壓迫使向上')}上升成雲。`},
                {q:"An analysis is", opts:["a. future forecast", "b. past comparison", "c. chart interpreting present weather", "d. long range method"], ans:2, exp:`正解為 <strong>(c)</strong>。<br>${t('分析場 (Analysis)','分析場','基於觀測資料分析「當下」大氣狀態的圖。')}。Prog才是未來的預報圖。`},
                {q:"Immediate future forecast using trend method is", opts:["a. nowcasting", "b. extrapolation", "c. first order", "d. linear"], ans:0, exp:`正解為 <strong>(a)</strong>。<br>極短期的趨勢預報稱為${t('即時預報 (Nowcasting)','即時預報','0-6小時內的精確預報')}。`},
                {q:"A prog is", opts:["a. current state chart", "b. instrument", "c. new method", "d. forecast chart for future time"], ans:3, exp:`正解為 <strong>(d)</strong>。<br>Prog 是 Prognostic chart，顯示大氣${t('未來','Prog','電腦預算的未來狀態')}狀態的圖。`},
