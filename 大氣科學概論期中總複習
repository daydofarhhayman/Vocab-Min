        function drawRadar() {
            rCan.width = rCan.parentElement.clientWidth; rCan.height = rCan.parentElement.clientHeight;
            const cx=rCan.width/2, cy=rCan.height/2, rad=Math.min(cx,cy);
            rTime+=0.02; let bp = (Math.sin(rTime)+1)/2;
            rCtx.lineCap='round'; rCtx.lineJoin='round';
            const seg=20, len=rad*1.2, sy=cy-len/2, bx=cx-rad*0.2;
            [{c:'rgba(34,197,94,0.6)',w:40}, {c:'rgba(234,179,8,0.8)',w:25}, {c:'rgba(239,68,68,0.9)',w:10}].forEach(l => {
                rCtx.beginPath(); rCtx.strokeStyle=l.c; rCtx.lineWidth=l.w;
                for(let i=0;i<=seg;i++){
                    let y = sy+(i*len/seg), d = Math.abs((i-seg/2)/(seg/2));
                    let x = bx + (1-d*d)*rad*0.6*bp + (Math.random()-0.5)*5;
                    i===0?rCtx.moveTo(x,y):rCtx.lineTo(x,y);
                }
                rCtx.stroke();
            });
            requestAnimationFrame(drawRadar);
        }
        drawRadar();

        // CH14 Hurricane Canvas
        const hCan = document.getElementById('ch14-hurrCanvas'), hCtx = hCan.getContext('2d');
        let hPts=[], hInt=0;
        function initH() { hPts=[]; for(let i=0;i<250;i++) hPts.push({s:Math.random()>0.5?1:-1, x:0, y:0, st:0, sp:Math.random()*2+1, sz:Math.random()*3+1, o:Math.random()*0.5+0.3, reset:function(w,h){this.x=w/2+this.s*w/2*(0.5+Math.random()*0.5); this.y=h-20; this.st=0; this.o=Math.random()*0.5+0.3;}}); }
        function updateH() {
            hCan.width = hCan.parentElement.clientWidth; hCan.height = hCan.parentElement.clientHeight;
            const w=hCan.width, h=hCan.height;
            if(hPts.length===0) { initH(); hPts.forEach(p=>p.reset(w,h)); }
            
            const grad = hCtx.createLinearGradient(0,h-40,0,h); grad.addColorStop(0,'#0f172a'); grad.addColorStop(1, hInt>0.5?'#991b1b':'#1e3a8a');
            hCtx.fillStyle=grad; hCtx.fillRect(0,h-40,w,40);
            
            if(hInt>0) {
                hCtx.fillStyle=`rgba(51,65,85,${hInt*0.8})`;
                hCtx.fillRect(w/2-100,40,60,h-80); hCtx.fillRect(w/2+40,40,60,h-80); // Eyewall
                hCtx.fillRect(w/2-200,100,40,h-140); hCtx.fillRect(w/2+160,100,40,h-140); // Rainband
                hCtx.fillRect(0,20,w,40); // Outflow
            }
            
            hPts.forEach(p => {
                if(hInt<=0) return;
                let s = p.sp*hInt;
                if(p.st===0) { p.x-=p.s*s*1.5; if(Math.abs(p.x-w/2)<100) p.st=1; }
                else if(p.st===1) { p.y-=s*2.5; p.x+=(Math.random()-0.5)*2; if(p.y<50) p.st=2; }
                else { p.x+=p.s*s*2; p.y-=s*0.2; p.o-=0.01; if(p.x<0||p.x>w||p.o<=0) p.reset(w,h); }
                hCtx.beginPath(); hCtx.arc(p.x,p.y,p.sz,0,Math.PI*2);
                hCtx.fillStyle = p.st===0?`rgba(239,68,68,${p.o})`:(p.st===1?`rgba(168,85,247,${p.o})`:`rgba(59,130,246,${p.o})`);
                hCtx.fill();
            });
            requestAnimationFrame(updateH);
        }
        
        function setH() {
            let v = parseFloat(document.getElementById('ch14-sstSlider').value);
            document.getElementById('ch14-sstVal').textContent = v+'°C';
            let stat = document.getElementById('ch14-hurrStatus');
            if(v<25){ hInt=0; stat.textContent='熱帶擾動'; stat.style.color='#94a3b8'; }
            else if(v<26.5){ hInt=0.3; stat.textContent='低氣壓'; stat.style.color='#eab308'; }
            else if(v<28){ hInt=0.8; stat.textContent='熱帶風暴'; stat.style.color='#f97316'; }
            else { hInt=1.5; stat.textContent='強烈颱風'; stat.style.color='#ef4444'; }
        }
        document.getElementById('ch14-sstSlider').addEventListener('input', setH);
        setH(); updateH();

    </script>
</body>
