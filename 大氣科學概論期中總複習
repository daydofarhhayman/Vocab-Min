        const spagCanvas = document.getElementById('ch13-spagCanvas'), spagCtx = spagCanvas.getContext('2d');
        let spagAnimId, spagPaths=[], spagStep=0;
        function runEnsemble13() {
            if(spagAnimId) cancelAnimationFrame(spagAnimId);
            const w=spagCanvas.parentElement.clientWidth, h=spagCanvas.parentElement.clientHeight;
            spagCanvas.width=w; spagCanvas.height=h;
            
            const err = parseInt(document.getElementById('ch13-errSlider').value);
            document.getElementById('ch13-errVal').textContent = err<30?'低':(err<70?'中':'高');
            const bdg = document.getElementById('ch13-confBadge');
            bdg.textContent = err<30?'預報可信度：高':(err<70?'預報可信度：中':'預報可信度：極低');
